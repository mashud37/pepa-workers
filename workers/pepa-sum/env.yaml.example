# Config for pepa-sum. Copy to env.yaml (gitignored) and run
# `python manage.py install`. Every value can be overridden by an env var
# (e.g. ANTHROPIC_API_KEY, PEPA_BACKEND, PEPA_PARA_METHOD).

# --- run settings ---
# Comprehension backend: "anthropic" (Claude Haiku, default) or "cloudrun"
# (self-hosted Qwen service — needs BASE_URL/JOB_TOKEN below + a deploy).
BACKEND: "anthropic"
# Paragraph-rundown (para_) method: "llm" (model condenses each paragraph) or
# "extractive" (deterministic: most central sentence per paragraph, no model).
PARA_METHOD: "llm"
# When a paper's three documents already exist: "ask" (prompt per paper),
# "skip" (keep them, never ask), or "overwrite" (always redo).
ON_EXISTING: "ask"
# Scanned-PDF handling (the slow path — tesseract per page): "auto" only OCRs a
# document that is mostly image (born-digital papers stay fast); "off" never OCRs
# (scanned papers yield little text and are skipped — fastest); "force" OCRs every
# sparse page. OCR_DPI trades speed for legibility (lower = much faster).
OCR: "auto"
OCR_DPI: 200
# Concurrent LLM requests for the paragraph rundown (1-8). Higher is faster on
# long papers; lower if you hit API rate limits. Forced to 1 on the cloudrun backend.
MAX_WORKERS: 4
# Papers processed at once across a batch (1-16). The big lever for large runs —
# most of each paper's time is spent waiting on the LLM, so several overlap well.
# A single paper runs serially; forced to 1 on the cloudrun backend.
PAPER_WORKERS: 6
# Hard cap on total LLM requests in flight at once across all papers and their
# internal fan-out (1-32). The real rate-limit guard: raise it with your API
# tier, lower it if you see repeated 429s.
MAX_CONCURRENCY: 16
# Speed tier preset: "eco" / "balanced" / "turbo". Sets default values for
# PAPER_WORKERS, MAX_CONCURRENCY, MAX_WORKERS, LOCAL_BATCH. Any set explicitly
# above override the tier's default. (The local reading pool, LOCAL_WORKERS, is
# sized to the machine's CPU cores instead — set it only to throttle memory.)
SPEED: "balanced"

# --- anthropic backend ---
# Your Claude API key. Paste it during install, or set the ANTHROPIC_API_KEY env var.
ANTHROPIC_API_KEY: ""
ANTHROPIC_MODEL: "claude-haiku-4-5-20251001"

# --- self-hosted (cloudrun) fallback backend ---
# Only needed when BACKEND is "cloudrun". Written/filled by deploy + install.
BASE_URL: ""
JOB_TOKEN: ""
MODEL: "qwen2.5-3b-instruct"
N_CTX: "16384"
