# Config for pepa-sum. Copy to env.yaml (gitignored) and run
# `python manage.py install`. Every value can be overridden by an env var
# (e.g. ANTHROPIC_API_KEY, PEPA_BACKEND, PEPA_PARA_METHOD).

# --- run settings ---
# Comprehension backend: "anthropic" (Claude Haiku, default) or "cloudrun"
# (self-hosted Qwen service — needs BASE_URL/JOB_TOKEN below + a deploy).
BACKEND: "anthropic"
# Paragraph-rundown (para_) method: "llm" (model condenses each paragraph) or
# "extractive" (deterministic: most central sentence per paragraph, no model).
PARA_METHOD: "llm"
# When a paper's three documents already exist: "ask" (prompt per paper),
# "skip" (keep them, never ask), or "overwrite" (always redo).
ON_EXISTING: "ask"
# Concurrent LLM requests for the paragraph rundown (1-8). Higher is faster on
# long papers; lower if you hit API rate limits. Forced to 1 on the cloudrun backend.
MAX_WORKERS: 4

# --- anthropic backend ---
# Your Claude API key. Paste it during install, or set the ANTHROPIC_API_KEY env var.
ANTHROPIC_API_KEY: ""
ANTHROPIC_MODEL: "claude-haiku-4-5-20251001"

# --- self-hosted (cloudrun) fallback backend ---
# Only needed when BACKEND is "cloudrun". Written/filled by deploy + install.
BASE_URL: ""
JOB_TOKEN: ""
MODEL: "qwen2.5-3b-instruct"
N_CTX: "16384"
