# Cloud Run config for pepa-sum. Copy to env.yaml (gitignored) and run
# `python manage.py install` to fill JOB_TOKEN; deploy writes BASE_URL.
# Every value can be overridden by an env var: BASE_URL -> PEPA_BASE_URL,
# JOB_TOKEN -> PEPA_JOB_TOKEN, MODEL -> PEPA_MODEL.

# Service URL, written automatically by the two-pass deploy. Do not hand-edit.
BASE_URL: ""
# Shared token guarding /summarize. Generated by install (secrets.token_hex(32)).
JOB_TOKEN: ""
# Instruction-tuned model served by the container (informational; the image
# pins the actual GGUF via the Dockerfile MODEL_GGUF_URL build arg).
MODEL: "qwen2.5-3b-instruct"
# Context window the served model allocates. Qwen2.5-3B supports up to 32768;
# 16384 is ample once references are stripped, and lighter on RAM.
N_CTX: "16384"
